#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets, keys and signing material
# Never commit these: they are personal credentials, not project files.
*.jks
*.keystore
*.p12
*.pem
key.properties

# Environment files (local configuration, API keys)
.env
.env.*
!.env.example

# Local machine configuration
local.properties

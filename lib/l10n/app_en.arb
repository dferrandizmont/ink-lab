  "ideaHorrorHalloweenStep2": "Place eerie accent hues only near focal shapes.",
  "ideaHorrorHalloweenStep3": "Use harder edge shadows for tension.",
  "ideaHorrorHalloweenStep4": "Keep bright highlights sparse and directional.",
  "ideaHorrorHalloweenEmbellishment1": "Add subtle color noise in shadows for unsettling texture.",
  "ideaHorrorHalloweenEmbellishment2": "Use one sharp high-contrast edge to create visual tension.",
  "ideaMidnightTitle": "Midnight",

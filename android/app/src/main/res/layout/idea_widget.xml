<?xml version="1.0" encoding="utf-8"?>
<!-- "Idea of the day" widget. Only views RemoteViews may inflate. The system
     reads @android:id/background to round the card on Android 12+. The colour
     chips are filled at runtime (setColorFilter on idea_chip_fill_N). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/idea_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/idea_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="@color/idea_widget_fg2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idea_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/idea_widget_fg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idea_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/idea_widget_fg2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/idea_chips"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/idea_chip_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/idea_widget_chip_edge"
            android:padding="1dp">

            <ImageView
                android:id="@+id/idea_chip_fill_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/idea_widget_chip_fill" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/idea_chip_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/idea_widget_chip_edge"
            android:padding="1dp">

            <ImageView
                android:id="@+id/idea_chip_fill_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/idea_widget_chip_fill" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/idea_chip_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/idea_widget_chip_edge"
            android:padding="1dp">

            <ImageView
                android:id="@+id/idea_chip_fill_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/idea_widget_chip_fill" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/idea_chip_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/idea_widget_chip_edge"
            android:padding="1dp">

            <ImageView
                android:id="@+id/idea_chip_fill_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/idea_widget_chip_fill" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/idea_chip_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/idea_widget_chip_edge"
            android:padding="1dp">

            <ImageView
                android:id="@+id/idea_chip_fill_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/idea_widget_chip_fill" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

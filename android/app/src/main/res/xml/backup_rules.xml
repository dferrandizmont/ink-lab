<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 (API 23-30) full-backup rules; see data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <!-- getApplicationDocumentsDirectory() is app_flutter/ in the root domain: the diary photos. -->
    <exclude domain="root" path="app_flutter/" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). The Keystore-wrapped API key and its wrapped-key
     preferences must never leave the device, neither via cloud backup nor
     device-to-device transfer (the Keystore key would not travel with them
     anyway). The user's own data has its own in-app export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <!-- getApplicationDocumentsDirectory() is app_flutter/ in the root domain: the diary photos. -->
        <exclude domain="root" path="app_flutter/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <!-- getApplicationDocumentsDirectory() is app_flutter/ in the root domain: the diary photos. -->
        <exclude domain="root" path="app_flutter/" />
    </device-transfer>
</data-extraction-rules>
